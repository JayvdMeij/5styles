---
interface Props {
	index: string;
	label: string;
	caption: string;
	rotation: number;
	offset: number;
}

const { index, label, caption, rotation, offset } = Astro.props;
---

<article class="tile" style={`transform: rotate(${rotation}deg); margin-top: ${offset}px;`} data-tile>
	<div class="tile-head">
		<span class="index">{index}</span>
		<span class="label">{label}</span>
	</div>
	<div class="hr" role="presentation"></div>
	<div class="canvas-clip" data-drift>
		<div class="canvas">
			<slot />
		</div>
	</div>
	<p class="caption" set:html={caption} />
</article>

<style>
	.tile {
		width: 246px;
		flex: none;
	}

	.tile-head {
		display: flex;
		align-items: baseline;
		gap: 8px;
	}
	.index {
		font-family: var(--font-display);
		font-size: 40px;
		line-height: 1;
		color: var(--ghost);
	}
	.label {
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.035em;
	}

	.hr {
		height: 1.5px;
		background: var(--ink);
		margin: 8px 0 12px;
	}

	.canvas-clip {
		width: 234px;
		height: 662px;
		overflow: hidden;
	}
	.canvas {
		position: relative;
		width: 198px;
		height: 560px;
		overflow: hidden;
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
		transform: scale(1.18);
		transform-origin: top left;
	}

	.caption {
		font-size: 14.5px;
		line-height: 1.5;
		margin: 14px 0 0;
	}
</style>
