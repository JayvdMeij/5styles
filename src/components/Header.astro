---
const links = [
	{ href: '#five', label: 'THE FIVE' },
	{ href: '#anatomy', label: 'ANATOMY' },
	{ href: '#rules', label: 'RULES' },
	{ href: '#timeline', label: 'TIMELINE' },
	{ href: '#archive', label: 'ARCHIVE' },
];
---

<header class="nav">
	<div class="brand">
		<span class="dot" aria-hidden="true"></span>
		POSTER LANGUAGE
	</div>
	<nav class="links">
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>
	<div class="est">EST. 1919</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 40;
		background: var(--ink);
		color: var(--paper);
		display: flex;
		align-items: center;
		gap: 28px;
		padding: 0 24px;
		height: 52px;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 15px;
		letter-spacing: -0.01em;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.dot {
		width: 11px;
		height: 11px;
		background: var(--accent);
		flex: none;
	}

	.links {
		display: flex;
		gap: 22px;
		font-size: 12.5px;
		font-weight: 700;
		letter-spacing: 0.06em;
		margin-left: auto;
	}
	.links a {
		color: var(--paper);
	}
	.links a:hover {
		color: var(--accent);
	}

	.est {
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding-left: 22px;
		border-left: 1px solid var(--hairline-dark-2);
		white-space: nowrap;
	}

	@media (max-width: 780px) {
		.links,
		.est {
			display: none;
		}
	}
</style>
